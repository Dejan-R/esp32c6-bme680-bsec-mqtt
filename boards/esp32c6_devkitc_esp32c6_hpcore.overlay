#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/ {
    aliases {
        bme680i2c = &i2c0;
        led-strip = &rgb_led;
    };
};


&pinctrl {

    i2c0_default: i2c0_default {
        group1 {
            pinmux = <I2C0_SDA_GPIO6>,
                     <I2C0_SCL_GPIO7>;
        };
    };

    i2s_ws2812_default: i2s_ws2812_default {
        group1 {
            pinmux = <I2S_O_SD_GPIO8>;
            output-enable;
        };
    };
};


&i2c0 {

    status = "okay";

    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";

    clock-frequency = <I2C_BITRATE_STANDARD>;
};


&i2s {

    status = "okay";

    pinctrl-0 = <&i2s_ws2812_default>;
    pinctrl-names = "default";

    dmas = <&dma 3>;
    dma-names = "tx";

    rgb_led: ws2812@0 {
        compatible = "worldsemi,ws2812-i2s";
        reg = <0>;

        chain-length = <1>;

        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;

        reset-delay = <500>;
    };
};


&dma {
    status = "okay";
};